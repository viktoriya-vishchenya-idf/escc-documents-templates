#import "../common/default_styles.typ": alpha-paren-bold-list
#import "../common/default_styles.typ": alpha-paren-list, clause-list
#import "../common/default_styles.typ": roman-paren-list, section-bold-h1, alpha-paren-list

#let clause-17-validacion-concesion-linea(vars) = [
    #section-bold-h1[17\. Validación y concesión de la línea de Crédito]

    #clause-list(17)[
    + Una vez que el Prestamista efectúe las comprobaciones pertinentes,
      remitirá al Prestatario, a través del Servicio a Distancia, la Decisión de
      Préstamo positiva. La valoración por el Prestamista de la oportunidad de
      conceder la línea de Crédito está sujeta al previo estudio de la misma y
      de la documentación que se acompaña. En el caso en que el Prestamista
      rechace la Solicitud por motivo de la consulta de ficheros de solvencia
      económica y de riesgos de crédito, el Prestamista, informará de forma
      gratuita e inmediata al solicitante acerca de las causas de denegación de
      la Solicitud a través del Servicio a Distancia. Esto no se aplica si la
      difusión de esa información está prohibida por una ley o por el Derecho de
      la Unión Europea o es contraria a los objetivos de orden público o de la
      seguridad pública.

      #linebreak()
      El Prestamista dispone de su #underline[propio modelo de evaluación de
      riesgo crediticio] y #underline[no basa sus decisiones únicamente en
      consultas a bases de datos de solvencia]. El Prestatario puede inquirir
      las causas de denegación a través de la dirección
      #link("mailto:clientes@plazo.es")[clientes\@plazo.es]. Todo ello, sin
      perjuicio del derecho reconocido al Prestatario en la Cláusula 16.3
      (Solicitud de la Línea de Crédito) de las presentes Condiciones Generales.

      #linebreak()

    + El Prestamista, en el caso que la Decisión de Préstamo sea positiva,
      pondrá a disposición del Prestatario, a través de correo electrónico, las
      de las condiciones del Crédito. Dichas condiciones ofrecidas serán válidas
      por un plazo máximo de 14 días desde que fueron enviadas por el
      Prestamista y, en consecuencia, deberán ser aceptadas por el Prestatario
      dentro de dicho plazo.

      #linebreak()
      Para la formalización del Contrato de línea de Crédito y para la recepción
      del importe solicitado, el Prestatario deberá aceptar el Contrato. Para
      realizar dicha #strong[aceptación], deberá aceptar la
      #underline[Información Normalizada Europea] sobre el Crédito al Consumo,
      las #underline[explicaciones adicionales] sobre Crédito Revolving, así
      como aceptar las #underline[condiciones de la línea de Crédito] mediante
      la marcación de los correspondientes botones del Servicio a Distancia.
      #strong[Estas acciones implicarán para el Prestatario el otorgar su
      consentimiento para la concesión de la línea de Crédito y la formalización
      electrónica del contrato.]

      #linebreak()

    + El #underline[#strong[marcado de la casilla de aceptación de las
      Condiciones Generales de Contratación (“Confirmar solicitud”) significa la
      aceptación por el Cliente del Contrato y la declaración expresa]] de que:

      #alpha-paren-bold-list[
      + #strong[Ha revisado la información de asistencia, la Información
        Normalizada Europea y las Condiciones Generales de Contratación,
        publicadas en la Aplicación móvil Plazo titularidad, de la Entidad
        colaboradora, del Prestamista.]

      + #strong[Acepta el contenido íntegro de las Condiciones Generales.]

      + #strong[Quiere que el Importe inicial de la línea de Crédito sea puesto
        a disposición del Prestatario].

      + #strong[Acepta que el Importe inicial de la línea de Crédito sea
        incrementado o reducido durante la duración de la línea de Crédito,
        conforme lo establezca el Prestamista] de acuerdo con lo expuesto en la
        cláusula 18.2 (Modificación de la Línea de Crédito) siguiente#strong[.]
      ]
      #linebreak()

    + Asimismo, completar y remitir la Solicitud supone que el Prestatario
      garantiza que:

      #alpha-paren-list[
      + No existen pagos pendientes o deudas con terceras partes que puedan
        impedir el pago de la línea de Crédito, incluidos pagos pendientes que
        estén registrados en cualquier lista de Prestamistas/Prestatarios como
        ASNEF.

      + No se encuentra incurso en procedimientos legales o judiciales que
        puedan afectar a su solvencia.

      + Toda la información y documentación suministrada al Prestamista es
        cierta, veraz y actualizada.

      + El Prestatario reconoce que la Tasa Anual Equivalente (T.A.E) se ha
        calculado sobre la base de las siguientes asunciones:

        #roman-paren-list[
        + La disposición del Crédito se prolongará durante el periodo de tiempo
          acordado.
        + El Prestamista y el Prestatario cumplirán sus obligaciones de la
          manera debida y oportuna.
        + El Coste Total del Crédito comprende todos los gastos obligatorios
          derivados de la suscripción del Contrato.
        + Los intervalos de tiempo entre las fechas utilizadas en los cálculos
          se expresarán en años o fracciones de año, teniendo en cuenta que un
          año será igual a 365 días.
        + La vigencia del Crédito se hará efectiva en la fecha en la que el
          Crédito dispuesto sea abonado en la tarjeta PLAZO del Prestatario.
        + Los costes opcionales no se incluirán a efectos del cálculo de la
          T.A.E.
        + El Prestatario abonará al Prestamista las cuotas debidas respecto del
          importe total debido antes del último día de su fecha de vencimiento.
        ]
      ]

      #linebreak()

    + En el supuesto en que la comunicación de la Decisión del Préstamo no se
      envíe con arreglo a lo previsto en estas Condiciones Generales de
      Contratación, se envíe fuera de plazo, o haya un rechazo previo por parte
      del Solicitante del Préstamo; se considerará que no ha habido Decisión de
      Préstamo y, por tanto, que no se ha perfeccionado el Contrato de Línea de
      Crédito.

      #linebreak()

    + La solicitud en los términos expuestos implica la aceptación y
      consentimiento al contrato, vinculando a ambas partes, manifestando que
      conocen plenamente el contenido del presente convenio.
    ]

    #linebreak()
]
