#import "../common/default_styles.typ": alpha-paren-list, bullet-list
#import "../common/default_styles.typ": section-bold-h1

#let clause-12-terminos-definiciones(vars) = [
    #section-bold-h1[12\. Términos y definiciones]

    En las presentes Condiciones Generales de Contratación se entiende por:

    #alpha-paren-list[
    + “#strong[Aplicación móvil]” se refiere a la app Plazo titularidad de
      IDFinance Plazo S.L.U..

    + “#strong[Área de Usuario]” se refiere a un servicio proporcionado por el
      Prestamista en la Aplicación móvil de la Entidad Colaboradora, que permite
      al Prestatario gestionar su Contrato y recibir las notificaciones del
      Prestamista.

    + “#strong[Comisiones Aplicables]” se refiere a cualquier comisión que pueda
      resultar de aplicación al Contrato de línea de Crédito, y que se encuentra
      recogida en la app Plazo.

    + “#strong[Contrato]” se refiere al presente contrato de línea de Crédito, que
      consta de estas Condiciones Generales, la Política de Privacidad, los costes
      y la Información Normalizada Europea sobre el Crédito al Consumo.

    + “#strong[Crédito]” se refiere a la cuantía pendiente total de los fondos
      dispuestos por el Prestatario

    + #strong[“Cuenta de Crédito”] se refiere a la cuenta abierta en la IDFinance
      PLAZO S.L.U.  que figura en la base de datos del Prestamista vinculada
      exclusivamente al Prestatario, en la que el Prestamista podrá ingresar las
      cantidades solicitadas al Prestatario, y que contiene datos acerca del
      Límite de Crédito solicitado por el Prestatario

    + “#strong[Cuenta Corriente de Domiciliación”] se refiere a la cuenta
      corriente en una entidad de Crédito distinta del Prestamista en la que el
      Prestatario haya indicado la domiciliación de los pagos.

    + “#strong[Día hábil]” se refiere a todos los días naturales de lunes a
      viernes, excepto los días festivos y otros días no considerados hábiles en
      España.

    + “#strong[Información Normalizada Europea sobre el Crédito al Consumo”] se
      refiere a la Información Normalizada Europea sobre el crédito al Consumo que
      ha sido elaborada de conformidad con el Anexo II de la Ley 16/2011, de 24 de
      junio, de Contratos de crédito al Consumo.

    + “#strong[Intereses]” se refiere a los intereses por el uso del Crédito,
      calculados en base al Tipo Deudor.

    + “#strong[Límite de Crédito”] se refiere a la cuantía máxima de Crédito
      otorgada en cada momento al Prestatario: en particular el Límite de Crédito
      inicial es el que figura en las Condiciones Generales como “Importe
      inicial”, y el mismo podrá ser incrementado o reducido por el Prestamista
      conforme se expone en la cláusula 18.2 (Modificación de la Línea de Crédito)
      siguiente.

    + “#strong[Importe Mínimo de Crédito”] se refiere al importe mínimo que podrá
      alcanzar el Límite de Crédito durante la vida del Crédito, conforme lo
      establezca el Prestamista de acuerdo con lo expuesto en la cláusula 18.2
      (Modificación de la Línea de Crédito) siguiente.

    + “#strong[Importe Máximo de Crédito]” se refiere al importe máximo que podrá
      alcanzar el Límite de Crédito durante la vida del Crédito, conforme lo
      establezca el Prestamista de acuerdo con lo expuesto en la cláusula 18.2
      (Modificación de la Línea de Crédito) siguiente.

    + “#strong[Método de Cálculo]” se refiere al método para la elaboración de un
      calendario de pago según el cual la cuantía mensual total del principal y
      los Intereses que deba pagar el Prestatario al Prestamista se mantienen
      constantes durante todo el periodo de reembolso, salvo el último pago que
      difiere debido al redondeo.

    + El #underline[#strong[“Pago mínimo”]] mensualmente se calcula como la suma
      de las siguientes cifras:

      #bullet-list[
        - El importe mayor de las siguientes cifras: 5 Euros o 1,85% del importe
          principal dispuesto, restando los intereses devengados y las
          penalizaciones por impago; más
        - los intereses correspondientes al periodo de liquidación; más
        - los intereses correspondientes e impagados del periodo de liquidación
          anterior (si estuviese impagado); más
        - la comisión por impago del periodo de liquidación, si estuviese
          impagado.
      ]

      El Prestatario #strong[no tiene la facultad de modificar el pago mínimo
      establecido], sin embargo, #underline[se advierte al Prestatario que la
      elección de cuotas de importe reducido podría dar lugar a una amortización
      del crédito más prolongada en el tiempo, con el consiguiente efecto de
      devengarse un mayor importe de intereses].

    + “#strong[Comisión por impago”] se refiere a la cantidad a repercutir por los
      costes de recuperación y gestión de recobro de cada cuota atrasada
      (correspondientes a la reclamación por costes efectivos de recobro), esto
      es, una comisión de #strong[30 Euros] que se aplicará tras la finalización
      de la fecha de liquidación, esto es, el día #vars.DD.

    + “#strong[Plazo Máximo de Reembolso]” se refiere al periodo de tiempo durante
      el cual el Prestatario deberá reembolsar el Crédito.

    + “#strong[Política de Privacidad]”~se refiere a la política de protección de
      datos aplicable a los datos del Prestatario obtenidos en virtud de la
      solicitud de la línea de Crédito en la Aplicación móvil Plazo de la Entidad
      colaboradora y que se encuentra disponible en la sección de “Avisos
      legales”.

    + #strong[“Prestamista”] es la entidad mercantil denominada IDFinance Plazo
      S.L.U., sociedad de nacionalidad española con domicilio social en Barcelona,
      calle Tuset 5, 3º y Número de Identificación Fiscal (N.I.F.) B02996668
      constituida en escritura pública de fecha 30 de diciembre de 2020 otorgada
      ante notario de Barcelona Gonzalo Veciana García-Boente con el número 1929
      de su protocolo, inscrita en el Registro Mercantil de Barcelona, al tomo /
      IRUS 1000380036447, folio 0, Hoja B 558.505.

    + “#strong[Prestatario]” se refiere al particular, mayor de edad, con
      residencia permanente en España, y titular de una cuenta en un banco
      domiciliado en España, que ha suscrito el presente Contrato con el
      Prestamista.

    + “#strong[Servicio a Distancia]” se refiere a las técnicas de comunicación a
      través de redes telemáticas, facilitadas por el Prestamista al Prestatario
      para llevar a cabo el registro en la Aplicación móvil, la Solicitud del
      Límite de Crédito, la formalización del Contrato y la concesión del Crédito,
      y tomar cualquier otra decisión de Crédito. A efectos de los contratos
      firmados a distancia, se refiere al proceso de contratación a través de la
      Página Web o cualquier otra técnica de comunicación telemática utilizada por
      el Prestatario.

    + “#strong[Solicitud]” se refiere a la solicitud de la línea de Crédito
      enviada por el Prestatario al Prestamista en formato electrónico, de acuerdo
      al procedimiento previsto en estas Condiciones Generales.

    + “#strong[Soporte Duradero]” se refiere a cualquier medio que permita al
      Prestatario acceder y/o almacenar la información dirigida al Prestatario, de
      manera que pueda recuperarse fácilmente durante un periodo de tiempo
      adecuado para los fines para los que ésta se proporciona, y que permita su
      reproducción sin cambios en la información almacenada.

    + “#strong[Tasa Anual Equivalente (T.A.E)]” se refiere al coste total del
      Crédito expresado en forma de porcentaje anual del importe total del
      Crédito. La T.A.E se ha calculado de conformidad con el Anexo I de la Ley
      16/2011, de 24 de junio, de Contratos de Crédito al Consumo.

    + “#strong[Tercero]” se refiere al particular o persona jurídica no
      considerada Parte de este Contrato.

    ]

    #alpha-paren-list(start: 27, slot: 25pt)[
    + “#strong[Tipo Deudor]” se refiere al tipo al cual se devengarán los
      Intereses.

    ]

    #linebreak()
]
