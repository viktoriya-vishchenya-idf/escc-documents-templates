#import "../common/default_styles.typ": section-bold-h1

#let clause-32-ley-aplicable-jurisdiccion(vars) = [
    #section-bold-h1[32\. Ley aplicable y jurisdicción]

    Estas Condiciones Generales de Contratación se rigen por la Ley española.
    Las Partes se someten, a su elección, para la resolución de los conflictos y
    con renuncia a cualquier otro fuero, a los Juzgados y Tribunales del
    domicilio del Prestatario.
]
